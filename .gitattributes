* text=auto
*.sh text eol=lf
mvnw text eol=lf
*.cmd text eol=crlf
*.mmdb binary
src/main/resources/META-INF/licenses/** -text
# Published bundles contain byte hashes. Preserve generated bytes on every OS.
examples/investigation-ja/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
examples/investigation-en/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

*.css text eol=lf
*.js text eol=lf

# Preserve inline CSP hashes and embedded source text.
examples/sample-report.html -text whitespace=-blank-at-eol,-blank-at-eof
examples/geoip-sample-report.html -text whitespace=-blank-at-eol,-blank-at-eof
