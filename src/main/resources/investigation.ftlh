<#ftl output_format="HTML" auto_esc=true>
<#macro chapter number><h2 id="chapter-${number?c}">${t(chapters[number-1])}</h2></#macro>
<#macro list values><ul><#list values as value><li>${t(value)}</li></#list></ul></#macro>
<#macro caseLinks ids><#list ids as id><#if caseVisible(id)><a href="#${id}">${id}</a><#else>${id}</#if><br></#list></#macro>
<#macro sourceLinks ids><#list ids as id><#if sourceVisible(id)><a href="#source-${id}">${id}</a><#else>${id}</#if><br></#list></#macro>
<#macro ruleLink engine id><#if ruleVisible(engine,id)><a href="#${ruleAnchor(engine,id)}">${id}</a><#else>${id}</#if></#macro>
<#macro timelineTable rows maximum>
<div class="timeline"><table><tr><th>${t("UTC time bin")}</th><th>${t("Requests")}</th><th>${t("Suspicious requests")}</th><th>${t("4xx / 5xx")}</th></tr>
<#list rows as row><tr><td>${row.time}</td><td>${row.requests?c}<meter min="0" max="${maximum?c}" value="${row.requests?c}">${row.requests?c}</meter></td><td>${row.suspicious_requests?c}<meter min="0" max="${maximum?c}" value="${row.suspicious_requests?c}">${row.suspicious_requests?c}</meter></td><td>${row.errors_4xx?c} / ${row.errors_5xx?c}</td></tr><#else><tr><td colspan="4">${t("No retained observations with a known timezone.")}</td></tr></#list></table></div>
</#macro>
<!doctype html><html lang="${lang}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"><title>${title}</title>
<style>
:root{color-scheme:light;--ink:#172b38;--muted:#526773;--line:#d9e2e8;--accent:#075e75}*{box-sizing:border-box}body{font:15px/1.65 system-ui,sans-serif;margin:0;background:#f3f6f8;color:var(--ink)}main{max-width:1320px;margin:auto;padding:36px 24px}h1{font-size:32px;line-height:1.35}h2{margin-top:44px;font-size:24px;border-bottom:2px solid var(--line);padding-bottom:10px}h3{font-size:19px}p,li,dd,td,th,code{overflow-wrap:anywhere}section.panel,article,nav,.chart{background:white;border:1px solid var(--line);border-radius:9px;padding:20px;margin:18px 0}a{color:var(--accent)}.table{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}th,td{padding:9px;border-bottom:1px solid var(--line);vertical-align:top;text-align:left}th{background:#edf3f6}dt{font-weight:650;margin-top:8px}dd{margin-left:16px}pre{background:#edf3f6;white-space:pre-wrap;overflow-wrap:anywhere;padding:14px;font:13px/1.5 ui-monospace,monospace}summary{cursor:pointer;color:var(--accent);font-weight:600}.muted{color:var(--muted)}.warning{border-left:5px solid #9b640d;padding:14px;background:#fff8ea}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}meter{display:block;width:100%;height:17px;margin:4px 0 12px}.timeline{max-height:620px;overflow:auto}footer{margin:36px 0;color:var(--muted)}@media print{body{background:white;color:black;font-size:10pt}main{padding:0;max-width:none}nav{display:none}h2{break-before:page}#chapter-1{break-before:auto}h2,h3,h4{break-after:avoid}article,section.panel,.chart{border-radius:0;padding:10px}.table,.timeline{overflow:visible;max-height:none}table{font-size:8pt;table-layout:fixed}th,td{padding:4px;word-break:break-word}tr{break-inside:avoid}pre{font-size:8pt}a{color:black}.grid{display:block}.chart{break-inside:avoid}}
</style></head><body><main>
<header><p class="muted">${t("Offline access log investigation")} · WebAuditJ ${r.analysis.version} · ${r.schema}</p><h1>${title}</h1><p><strong>${t("Analysis status")}: ${t(r.status)}</strong> · ${t("Count quality")}: ${t(r.count_quality)}</p><#if !r.complete><p class="warning"><strong>${t("Incomplete investigation")}</strong> ${t("Read the inventory, coverage and limitations before interpreting the results.")}</p></#if><p>${t("This report identifies suspicious observations and corroborating evidence to seek. Access logs alone do not confirm intrusion or damage.")}</p></header>
<nav id="contents"><h2>${t("Contents")}</h2><ol><#list chapters as name><li><a href="#chapter-${name?index+1}">${t(name)}</a></li></#list></ol><p><a href="report.json">${t("Structured report")}</a> · <a href="manifest.json">${t("Manifest and artifact hashes")}</a></p></nav>
<@chapter 1/>
<section class="panel"><dl><dt>${t("Report title")}</dt><dd>${title}</dd><dt>${t("Target system")}</dt><dd>${specified(r.metadata.system)}</dd><dt>${t("Investigation background")}</dt><dd>${specified(r.metadata.background)}</dd><dt>${t("Investigation purpose")}</dt><dd>${specified(r.metadata.purpose)}</dd><dt>${t("Investigator")}</dt><dd>${specified(r.metadata.investigator)}</dd><dt>${t("Period:")}</dt><dd>${n(r.analysis.first)} — ${n(r.analysis.last)}</dd><dt>${t("Analysis started / finished")}</dt><dd>${r.started_at} — ${r.finished_at}</dd><dt>${t("Version / rule version")}</dt><dd>${r.analysis.version} / ${r.analysis.rules_version}</dd></dl></section>
<h3>${t("Investigation result summary")}</h3><table><tr><th>${t("Metric")}</th><th>${t("Count / value")}</th><th>${t("Scope and quality")}</th></tr>
<tr><td>${t("Input files")}</td><td>${r.summary.input_files?c}</td><td>${t("Includes failed inventory entries")}</td></tr><tr><td>${t("Total observed log lines")}</td><td>${r.summary.total_lines?c}</td><td>${t(r.count_quality)}</td></tr><tr><td>${t("Parsed / unparsed / excluded lines")}</td><td>${r.summary.parsed_lines?c} / ${r.summary.unparsed_lines?c} / ${r.summary.excluded_lines?c}</td><td>${t("Blank lines and explicitly deduplicated files are excluded")}</td></tr><tr><td>${t("Parsed request observations")}</td><td>${r.summary.total_requests?c}</td><td>${t("Successfully parsed observations after file deduplication")}</td></tr><tr><td>${t("Unique source IPs")}</td><td>${r.summary.unique_ips?c}</td><td>${t(r.statistics.unique_ip_quality)}</td></tr><tr><td>${t("Suspicious requests / percentage")}</td><td>${r.summary.suspicious_requests?c} / ${n(r.summary.suspicious_percent)}%</td><td>${t(r.statistics.suspicious_count_quality)}</td></tr><tr><td>${t("Suspicious source IPs")}</td><td>${r.summary.suspicious_ips?c}</td><td>${t(r.statistics.unique_ip_quality)} · ${t(r.statistics.suspicious_count_quality)}</td></tr><tr><td>${t("Detections / WebAudit incidents")}</td><td>${r.summary.detections?c} / ${r.summary.findings?c}</td><td>${t("Detection conditions and requests are different units; engines can overlap")}</td></tr><tr><td>${t("Priority investigation cases")}</td><td>${r.summary.priority_findings?c}</td><td>${t("Existing severity and possible-success cases determine review priority, not verified impact")}</td></tr><tr><td>${t("Full request evidence complete")}</td><td>${t(r.evidence_complete?c)}</td><td><a href="suspicious-requests.csv">${t("All suspicious request observations")}</a> · <a href="related-requests.csv">${t("All related observations")}</a></td></tr></table>
<h3>${t("Detection engines")}</h3><dl><#list r.summary.detections_by_engine as engine,count><dt>${engine}</dt><dd>${count?c} ${t("detections")}</dd></#list></dl><h3>${t("Main warnings")}</h3><ul><#list r.analysis.warnings as warning><li>${diagnostic(warning)}</li><#else><li>${t("No execution warning was recorded; this does not establish complete security coverage.")}</li></#list></ul>
<@chapter 2/>
<p>${t("Target system")}: ${specified(r.metadata.system)}</p><p>${t("Source IP method")}: ${t("The recorded peer is used; forwarded headers are untrusted and proxy topology is not verified.")}</p><p>${t("Formats and field availability are recorded per input. Available means observed in at least one parsed record, not present in every record.")}</p>
<div class="table"><table><tr><th>${t("File identifier / path")}</th><th>${t("Bytes / original SHA-256")}</th><th>${t("Compression / parser / log type")}</th><th>${t("Observed period / lines")}</th><th>${t("Status / limits / errors")}</th></tr><#list inventory as file><tr><td>${file.id}<br>${file.path}</td><td>${n(file.size_bytes)}<br>${n(file.sha256)}<br>${t(file.hash_scope)} · ${t(file.hash_status)}</td><td>${file.compression}<br>${file.formats?join(", ")}<br>${file.log_types?join(", ")}<br>${t("Recorded timezone offsets")}: ${file.timezones?join(", ")}<#if file.timezones_truncated> · ${t("Samples limited")}</#if></td><td>${n(file.first)} — ${n(file.last)}<br>${t("Total / parsed / unparsed / excluded")}: ${file.total_lines?c} / ${file.parsed?c} / ${file.unparsed?c} / ${file.excluded?c}<br>${t(file.count_quality)}</td><td>${t(file.status)}<br>${t("Truncated")}: ${t(file.truncated?c)}<br>${t("Changed during analysis")}: ${t(file.changed_during_analysis?c)}<br>${diagnostic(file.error!"")}<details><summary>${t("Available fields")}</summary><@list file.available_fields/></details></td></tr></#list></table></div><#if truncated_inventory><p class="warning">${t("HTML display limit reached; use the complete CSV annex.")}</p></#if><p><a href="log-inventory.csv">${t("Complete input inventory")}</a></p>
<h3>${t("Missing fields and unavailable evidence")}</h3><dl><#list r.analysis.missing_fields as field,count><dt>${t(field)}</dt><dd>${count?c} ${t("parsed observations without this field")}</dd></#list></dl><p>${t("Request and response bodies, database audit results, host execution and file integrity are not established by these parsed records. HTTP error and authentication-failure indicators are included when supplied and supported; they do not replace application or authentication audits.")}</p><p>${t("Unknown-time observations")}: ${r.statistics.unknown_time_requests?c} · ${t("Empty intervals do not establish missing logs.")}</p>
<@chapter 3/>
<ol><li>${t("Regular files are discovered in deterministic path order and streamed with bounded line and decompressed-file sizes; gzip is identified by content.")}</li><li>${t("Strict supported parsers preserve source file and line. Custom formats require explicit named capture groups; the regex body is not stored in the manifest.")}</li><li>${t("URL normalization emits bounded decoding and case/slash variants for detection; it does not establish how the application interprets the request.")}</li><li>${t("Known offsets are retained and timeline bins use UTC. Timezone-free error records need an explicit error timezone for cross-log time comparison.")}</li><li>${t("L1 signatures, overlapping five-minute behavior windows, leaky buckets and sample-aware median/MAD anomalies reuse the existing engines.")}</li><li>${t("Incidents group recorded IP, host, User-Agent, technique family and five-minute partition. This is a correlation hypothesis, not verified identity or attack progression.")}</li><li>${t("Hub and Aura source detections remain independent. GeoIP and ASN similarity provide investigation context without changing attack scores or outcomes.")}</li><li>${t("Full request snapshots are spooled under a disk limit, then associated with completed detections. Aggregate members may be normal and are exported as related evidence.")}</li><li>${t("Confirmed success or failure is not inferred from an HTTP status alone. Existing outcome guidance identifies corroborating evidence to collect.")}</li></ol>
<h3>${t("Applied settings and limits")}</h3><dl><#list r.settings as key,value><dt>${key}</dt><dd>${j(value)}</dd></#list></dl><details><summary>${t("Rules, prerequisites and exact conditions")}</summary><p>${t("Source descriptions and conditions are retained as supplied. Unsupported rules and insufficient prerequisites are distinguished in coverage.")}</p><table><tr><th>${t("Rule / engine")}</th><th>${t("Supported / enabled")}</th><th>${t("Required fields / condition")}</th></tr><#list rules as rule><tr id="${ruleAnchor(rule.engine,rule.id)}"><td>${rule.id}<br>${rule.engine} · ${rule.kind}<br>${t(rule.description)}</td><td>${t(rule.supported?c)} / ${t(rule.enabled?c)}</td><td>${rule.required_fields?join(", ")}<pre>${rule.condition}</pre></td></tr></#list></table><#if truncated_rules><p class="warning">${t("HTML display limit reached; use the complete CSV annex.")}</p></#if></details><p><a href="analysis-rules.csv">${t("Complete rule inventory")}</a> · <a href="manifest.json">${t("Build, rule hashes and applied configuration")}</a></p>
<@chapter 4/>
<p class="warning">${t("Existing severity is rule priority. These logs do not establish the evidence-based impact grade below. Detection confidence is unknown unless separately assessed; attack score is not converted into confidence or a probability.")}</p><table><tr><th>${t("Severity")}</th><th>${t("Evidence-based impact criterion")}</th></tr><tr><td>${t("critical")}</td><td>${t("Strong evidence of severe impact requiring immediate response; applicability is unverified in access-only analysis.")}</td></tr><tr><td>${t("high")}</td><td>${t("Potentially serious attack or suspected success requiring priority investigation.")}</td></tr><tr><td>${t("medium")}</td><td>${t("Suspected attack attempt or suspicious activity.")}</td></tr><tr><td>${t("low")}</td><td>${t("Probing or weaker anomaly indicators.")}</td></tr><tr><td>${t("informational")}</td><td>${t("Investigation context.")}</td></tr></table>
<h3>${t("Detection confidence")}</h3><table><tr><th>${t("Level")}</th><th>${t("Meaning")}</th></tr><tr><td>${t("high")}</td><td>${t("Clear features supporting an attack attempt.")}</td></tr><tr><td>${t("medium")}</td><td>${t("Suspicious features with plausible legitimate explanations.")}</td></tr><tr><td>${t("low")}</td><td>${t("Limited supporting evidence.")}</td></tr><tr><td>${t("unknown")}</td><td>${t("Not evaluated by the existing detectors; no score conversion is performed.")}</td></tr></table><h3>${t("Outcome and outcome confidence")}</h3><p>${t("Confirmed success, possible success, unknown, likely failure and confirmed failure are separate from detection. Outcome confidence describes evidence strength and is not a calibrated probability.")}</p><table><tr><th>${t("Outcome")}</th><th>${t("Incidents")}</th></tr><#list r.analysis.outcomes as key,count><tr><td>${outcome(key)}</td><td>${count?c}</td></tr></#list></table>
<@chapter 5/>
<p>${t(r.statistics.population)}</p><p>${t("Timeline resolution, seconds")}: ${r.statistics.timeline_resolution_seconds?c} · ${t("Unknown-time observations")}: ${r.statistics.unknown_time_requests?c} · ${t("Omitted timeline observations")}: ${r.statistics.omitted_timeline_requests?c}</p><div class="chart"><h3>${t("Requests and suspicious requests over time")}</h3><p>${t("Each row labels the UTC bin and both counts; bars share the same request scale.")}</p><@timelineTable timeline timeline_max/><p><a href="statistics/timeline.csv">${t("Complete timeline CSV")}</a> · ${t(r.statistics.suspicious_count_quality)}</p></div>
<div class="grid"><#list charts as chart><div class="chart"><h3>${t(chart.title)}</h3><#list chart.rows as row><div>${row.label} · ${row.count?c}<meter min="0" max="${chart.maximum?c}" value="${row.count?c}">${row.count?c}</meter></div><#else><p>${t("No retained rows.")}</p></#list><p><a href="${chart.annex}">${t("Complete CSV annex")}</a> · ${t("Available grouped rows")}: ${chart.total_rows?c}</p></div></#list></div>
<h3>${t("Response bytes and processing time")}</h3><table><tr><th>${t("Metric")}</th><th>${t("Known / missing / invalid")}</th><th>${t("Minimum / maximum / mean")}</th><th>${t("Sum / quality")}</th></tr><#list [r.statistics.response_bytes,r.statistics.request_duration] as metric><tr><td>${t(metric.unit)}</td><td>${metric.count?c} / ${metric.missing?c} / ${metric.invalid?c}</td><td>${n(metric.min)} / ${n(metric.max)} / ${n(metric.mean)}</td><td>${n(metric.sum)} / ${t(metric.sum_quality)}</td></tr></#list></table><p><a href="statistics/numeric-summary.csv">${t("Numeric statistics CSV")}</a></p><@list r.statistics.notes/><#if r.statistics.truncated><p class="warning">${t("Statistical detail is bounded; inspect other buckets, label truncation and unique-IP count quality in the CSV annexes.")}</p></#if>
<#if r.statistics.geoip_enabled><h3>${t("GeoIP database provenance")}</h3><pre>${j(r.analysis.geoip.databases)}</pre><dl><#list r.statistics.geo_lookup_statuses as key,count><dt>${key}</dt><dd>${count?c}</dd></#list></dl><p>${t("Country and ASN alone do not establish maliciousness, shared identity or attack success.")}</p><#else><p>${t("No usable GeoIP database was configured; geographical results are unavailable, not zero.")}</p></#if>
<@chapter 6/>
<p>${t("Evaluation completeness and detection presence are independent. A detected row may still be partially evaluated. Unsupported, not performed and unable are not no-detection results.")}</p><div class="table"><table><tr><th>${t("Perspective / rule")}</th><th>${t("Engine / conditions")}</th><th>${t("Evaluation / detected")}</th><th>${t("Eligible / direct / related / detections")}</th><th>${t("Findings and limitations")}</th></tr><#list coverage as row><tr id="coverage-${row.id}"><td>${row.id}<br>${t(row.name)}</td><td>${row.engines?join(", ")}<br>${row.rule_ids?join(", ")}<details><summary>${t("Conditions")}</summary><#list row.conditions as condition><pre>${condition}</pre></#list></details></td><td>${t(row.status)}<br>${t("Complete")}: ${t(row.complete?c)}<br>${t("Has detections")}: ${t(row.has_detections?c)}</td><td>${n(row.eligible_requests)} / ${n(row.detected_requests)} / ${n(row.related_requests)} / ${n(row.detections)}<br>${t(row.count_quality)}</td><td><@caseLinks row.finding_ids/><@list row.limitations/></td></tr></#list></table></div><#if truncated_coverage><p class="warning">${t("HTML display limit reached; use the complete CSV annex.")}</p></#if><p><a href="analysis-coverage.csv">${t("Complete coverage CSV")}</a></p>
<@chapter 7/>
<p>${t("WebAudit incidents and independent source detections are separate units. Their request counts overlap and must not be added as unique requests.")}</p><h3 id="incident-list">${t("WebAudit incidents")}</h3><div class="table"><table><tr><th>${t("Incident / categories")}</th><th>${t("First / last")}</th><th>${t("Source / country / ASN")}</th><th>${t("Host / URI samples")}</th><th>${t("Requests / detections / status")}</th><th>${t("Severity / detection confidence / score")}</th><th>${t("Outcome / evidence strength")}</th><th>${t("Priority / engine")}</th></tr>
<#list cases as item><#assign f=item.finding m=item.metrics a=item.assessment><tr><td><a href="#${f.id}">${f.id}</a><br><#list f.rules as rule>${t(rule.description)}<br></#list>${f.categories?join(", ")}</td><td>${n(f.first)} — ${n(f.last)}</td><td>${f.ip}<br>${t("Recorded peer IPs in this incident")}: 1<#if f.geoip??><br>${n(f.geoip.country_code)} / ${n(f.geoip.asn)}<br>${n(f.geoip.asn_organization)}</#if></td><td>${n(f.host)}<br><#list m.uri_samples as uri>${uri}<br></#list></td><td>${m.requests?c} / ${m.detections?c}<br>${t("Direct / related")}: ${m.direct_requests?c} / ${m.related_requests?c}<pre>${j(m.status_counts)}</pre></td><td>${t(f.severity)} / ${t(a.detection_confidence)} / ${f.attack_score?c}/100</td><td>${outcome(f.outcome.verdict)} / ${n(f.outcome.confidence)}</td><td>${t(a.priority)}<br>WebAudit<br><a href="#${f.id}">${t("Detailed analysis")}</a></td></tr><#else><tr><td colspan="8">${t("No retained WebAudit incidents. Review independent detections and coverage.")}</td></tr></#list></table></div><#if truncated_cases><p class="warning">${t("HTML display limit reached; use the complete CSV annex.")}</p></#if><p><a href="findings.csv">${t("Complete incident CSV")}</a></p>
<h3 id="source-list">${t("Independent source detections")}</h3><div class="table"><table><tr><th>${t("Detection / rule / engine")}</th><th>${t("First / last")}</th><th>${t("Source / group")}</th><th>${t("Direct / related")}</th><th>${t("Severity")}</th><th>${t("Outcome")}</th></tr><#list sources as item><#assign d=item.detection><tr><td><a href="#source-${d.id}">${d.id}</a><br>${d.rule_id}<br>${d.engine}</td><td>${n(d.first)} — ${n(d.last)}</td><td>${n(d.source_ip)}<br>${item.source.group}</td><td>${d.request_count?c} / ${d.related_request_count?c}</td><td>${t(d.severity)}</td><td>${t("Not assessed")}</td></tr><#else><tr><td colspan="6">${t("No retained independent source detections.")}</td></tr></#list></table></div><#if truncated_sources><p class="warning">${t("HTML display limit reached; use the complete CSV annex.")}</p></#if><p><a href="detections.csv">${t("Complete detection CSV")}</a></p>
<@chapter 8/>
<#list cases as item><#assign f=item.finding m=item.metrics a=item.assessment><article id="${f.id}"><h3>${f.id} · ${f.categories?join(", ")}</h3><p><a href="#incident-list">${t("Back to incident list")}</a> · <a href="#contents">${t("Contents")}</a></p><p>${t("Severity")}: ${t(f.severity)} · ${t("Detection confidence")}: ${t(a.detection_confidence)} · ${t("Outcome")}: ${outcome(f.outcome.verdict)} · ${t("Outcome and outcome confidence")}: ${n(f.outcome.confidence)} · ${t("Priority")}: ${t(a.priority)}</p><p>${n(f.first)} — ${n(f.last)} · ${f.ip} · ${n(f.host)} · ${n(f.user_agent)}</p><#if f.geoip??><pre>${j(f.geoip)}</pre></#if>
<h4>${t("Related coverage and rules")}</h4><#list a.coverage_ids as id><#if coverageVisible(id)><a href="#coverage-${id}">${id}</a><#else>${id}</#if><br></#list><#list item.rules as rule><p><@ruleLink rule.engine rule.id/> · ${t(rule.description)} · ${t(rule.severity)}</p><pre>${rule.condition}</pre><p>${t("Required fields / condition")}: ${rule.required_fields?join(", ")}</p></#list>
<h4>${t("Observed request statistics")}</h4><p>${t("Requests / detections / status")}: ${m.requests?c} / ${m.detections?c} · ${t("Direct / related")}: ${m.direct_requests?c} / ${m.related_requests?c} · ${t(r.count_quality)}</p><p>${t("Observed first / last")}: ${n(m.first)} — ${n(m.last)} · ${t("Observed-span average requests/second")}: ${n(m.request_rate_per_second)}</p><p>${t("Known response bytes: count / min / max / mean")}: ${m.bytes_count?c} / ${n(m.bytes_min)} / ${n(m.bytes_max)} / <#if m.bytes_count gt 0>${n(m.bytes_sum/m.bytes_count)}<#else>${t("unknown")}</#if></p><pre>${j(m.status_counts)}
${j(m.methods)}</pre><p>${t("Retained unique URIs / quality")}: ${m.retained_unique_uris?c} / ${t(m.unique_uri_quality)}</p><table><tr><th>${t("URI")}</th><th>${t("Requests")}</th></tr><#list m.uri_statistics as uri><tr><td><#if uri.other>${t("Other groups")}<#else>${n(uri.value)}</#if></td><td>${uri.requests?c}</td></tr></#list></table><p>${t("Timeline resolution, seconds")}: ${m.timeline_resolution_seconds?c}</p><pre>${j(m.timeline)}</pre>
<h4>${t("Observed facts")}</h4><@list a.facts/><h4>${t("Rule-based inferences")}</h4><@list a.inferences/><h4>${t("Unverified matters")}</h4><@list a.unknowns/><h4>${t("Legitimate activity and false-positive possibilities")}</h4><@list a.benign_alternatives/><h4>${t("Conditional impact")}</h4><@list a.conditional_impacts/><h4>${t("Outcome reasoning")}</h4><@list f.outcome.reasons/><@list f.outcome.next/>
<h4>${t("Related incidents and peers")}</h4><@caseLinks a.related_finding_ids/><p>${a.related_ips?join(", ")}</p><p>${t("Similarity is context only; it does not establish a common actor.")}</p>
<h4>${t("Representative log evidence")}</h4><p>${t("Representative samples are bounded. Full suspicious and related observations are in the CSV annexes.")}</p><#list item.samples as sample><p>${sample.reference.request_id} · ${sample.reference.source_file_id} · ${sample.reference.source_file}:${sample.reference.source_line?c} · ${n(sample.evidence.event.time)} · ${n(sample.evidence.event.method)}</p><pre>${sample.evidence.event.raw}</pre><details><summary>${t("Normalization before / after and steps")}</summary><pre>${j(sample.evidence.normalization)}</pre></details><#else><p>${t("No retained raw sample; use source references and the complete annexes.")}</p></#list><p><a href="suspicious-requests.csv">${t("All suspicious request observations")}</a> · <a href="related-requests.csv">${t("All related observations")}</a></p>
<h4>${t("Additional investigation")}</h4><#list f.outcome.investigation as guide><h5>${t(guide.category)}</h5><p>${t(guide.why_unknown)}</p><@list guide.where_to_check/><p>${t("Success evidence to seek")}: ${t(guide.success_evidence)}</p><p>${t("Failure evidence to seek")}: ${t(guide.failure_evidence)}</p></#list><p><a href="#incident-list">${t("Back to incident list")}</a></p></article></#list>
<#list sources as item><#assign d=item.detection><article id="source-${d.id}"><h3>${d.id} · ${d.rule_id}</h3><p><a href="#source-list">${t("Back to source detection list")}</a> · <a href="#contents">${t("Contents")}</a></p><p>${d.engine} · ${t("Severity")}: ${t(d.severity)} · ${t("Detection confidence")}: ${t(d.detection_confidence)} · ${t("Outcome")}: ${t("Not assessed")}</p><p>${n(d.first)} — ${n(d.last)} · ${n(d.source_ip)} · ${item.source.group}</p><p>${t("Observed first / last")}: ${n(d.observed_first)} — ${n(d.observed_last)}</p><p>${t("Direct / related")}: ${d.request_count?c} / ${d.related_request_count?c} · ${t(d.count_quality)}</p><p><@ruleLink d.engine d.rule_id/> · ${t(d.reason)}</p><pre>${d.condition}</pre><p>${t("Retained unique URIs / quality")}: ${d.retained_unique_uris?c} / ${t(d.unique_uri_quality)}</p><pre>${j(d.status_counts)}
${j(d.methods)}
${j(d.uri_statistics)}
${j(d.response_bytes)}</pre><p>${t("Independent detections are not merged into WebAudit incidents. Group membership does not confirm maliciousness or attack success.")}</p><h4>${t("Representative log evidence")}</h4><#list item.samples as sample><p>${sample.reference.request_id} · ${sample.reference.source_file_id} · ${sample.reference.source_file}:${sample.reference.source_line?c}</p><pre>${sample.sample.raw}</pre><#else><p>${t("No retained raw sample; use source references and the complete annexes.")}</p></#list><#list d.evidence_refs as ref><p>${ref.request_id} · ${ref.source_file_id} · ${ref.source_file}:${ref.source_line?c}</p></#list><p><a href="detections.csv">${t("Complete detection CSV")}</a> · <a href="#source-list">${t("Back to source detection list")}</a></p></article></#list>
<@chapter 9/>
<p>${t("Observed suspicious requests")}: ${r.summary.suspicious_requests?c} · ${t("Detections")}: ${r.summary.detections?c} · ${t("WebAudit incidents")}: ${r.summary.findings?c} · ${t("Priority investigation cases")}: ${r.summary.priority_findings?c}</p><#if r.summary.total_requests == 0><p>${t("No parsed request observations are available; detection absence cannot be assessed.")}</p><#elseif r.summary.detections == 0><p>${t("No suspicious activity was detected within the evaluated scope and detection conditions. This does not prove the absence of unauthorized access.")}</p><#else><p>${t("The observed signatures and aggregate review candidates require context-dependent investigation. The counts and links above identify the supporting observations; they do not establish intrusion, damage or a single attacker.")}</p></#if><p>${t("Concentration by IP, URI, host, time and ASN is shown in the preceding statistics. Repeated observations show recorded continuity only, and shared attributes do not verify a common actor.")}</p><p>${t("Possible-success cases require corroboration before any success claim. Unknown outcomes remain unknown when historical evidence is unavailable.")}</p><#list cases as item><#if item.finding.outcome.verdict == "possible_success"><p><a href="#${item.finding.id}">${item.finding.id}</a> · ${outcome(item.finding.outcome.verdict)} · ${t(item.assessment.priority)}</p></#if></#list>
<@chapter 10/>
<h3>${t("General limitations")}</h3><p>${t("Request and response bodies, database audit results, host execution and file integrity are not established by these parsed records. HTTP error and authentication-failure indicators are included when supplied and supported; they do not replace application or authentication audits.")}</p><p>${t("Unseen attack patterns, obfuscation, false positives, proxy address ambiguity, GeoIP accuracy and the existing time-window/source-compatibility limits constrain interpretation.")}</p><h3>${t("Limitations observed in this execution")}</h3><ul><#list r.analysis.warnings as warning><li>${diagnostic(warning)}</li></#list><#list r.evidence.incomplete_reasons as warning><li>${t(warning)}</li></#list></ul><p>${t("Evidence spool bytes")}: ${r.evidence.spool_bytes?c} · ${t("Full request evidence complete")}: ${t(r.evidence_complete?c)}</p><p>${t("HTML is a bounded presentation. Complete retained data and completeness notes are in the CSV and JSON annexes.")}</p><h3>${t("Masking and evidence handling")}</h3><p>${t("Masking enabled")}: ${t(r.masking_enabled?c)}</p><@list r.masking_notes/>
<@chapter 11/>
<p>${t("Recommendations are evidence-seeking or conditional preventive reviews tied to retained cases, not findings of confirmed compromise.")}</p><div class="table"><table><tr><th>${t("Action / type / priority")}</th><th>${t("Reason and related cases")}</th><th>${t("Where and how to check")}</th><th>${t("Evidence required")}</th></tr><#list r.recommendations as rec><tr><td>${rec.id}<br>${rec.title}<br>${t(rec.type)} · ${t(rec.priority)}</td><td>${rec.reason}<br><@caseLinks rec.finding_ids/><@sourceLinks rec.detection_ids/></td><td><@list rec.where_to_check/><p>${rec.method}</p><p>${n(rec.first)} — ${n(rec.last)}<br>${n(rec.source_ip)} · ${n(rec.host)}<br><#list rec.uri_samples as uri>${uri}<br></#list></p></td><td>${t("Success evidence to seek")}: ${n(rec.success_evidence)}<br>${t("Failure evidence to seek")}: ${n(rec.failure_evidence)}</td></tr></#list></table></div><#if r.recommendations_truncated><p class="warning">${t("Recommendation limit reached; recommendations are incomplete")}</p></#if><p><a href="recommendations.csv">${t("Complete recommendations CSV")}</a></p><footer><a href="#contents">${t("Contents")}</a> · <a href="manifest.json">${t("Manifest and artifact hashes")}</a></footer>
</main></body></html>
