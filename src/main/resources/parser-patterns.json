{
  "requestMethod": "^[A-Za-z0-9_]+$",
  "requestVersion": "^HTTP/[+-]?[0-9]+(?:\\.[0-9]+)?$",
  "standard": "^(?:(?P<host>[^\\s]+) )?(?P<ip>[0-9a-fA-F:.]+) [^\\s]+ (?:[^\\s]+ )?\\[(?P<time>[^\\]]+)\\] \"(?P<request>(?:[^\"\\\\]|\\\\.)*)\" (?P<status>[0-9]{3}|-) (?P<bytes>[0-9]+|-)(?: \"(?P<referer>(?:[^\"\\\\]|\\\\.)*)\" \"(?P<ua>(?:[^\"\\\\]|\\\\.)*)\")?$",
  "rfc3164": "^(?:<[0-9]{1,3}>)?[A-Z][a-z]{2} +[0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2} [^ ]+ [^ :]+(?:\\[[0-9]+\\])?: ",
  "rfc5424": "^<[0-9]{1,3}>[1-9][0-9]* \\S+ \\S+ \\S+ \\S+ \\S+ ",
  "extendedStandard": "^(?:(?P<host>[^\\s]+) )?(?P<ip>[0-9a-fA-F:.]+) [^\\s]+ (?:[^\\s]+ )?\\[(?P<time>[^\\]]+)\\] \"(?P<request>(?:[^\"\\\\]|\\\\.)*)\" (?P<status>[0-9]{3}|-) (?P<bytes>[0-9]+|-) \"(?P<referer>(?:[^\"\\\\]|\\\\.)*)\" \"(?P<ua>(?:[^\"\\\\]|\\\\.)*)\"(?P<suffix> .+)$",
  "npmPlus": "^\\[(?P<time>[^\\]]+)\\] (?P<host>\\S+) (?P<ip>\\S+) [0-9.]+ \"(?P<request>[^\"]*)\" (?P<status>[0-9]{3}) (?P<bytes>[0-9]+) [0-9]+ (?P<referer>\\S+) (?P<ua>.*)$",
  "npmLegacy": "^\\[(?P<time>[^\\]]+)\\](?: (?:HIT|MISS|BYPASS|EXPIRED|STALE|UPDATING|REVALIDATED|-) (?:-|[0-9]*))? (?P<status>[0-9]{3}) - (?P<method>\\w+) \\w+ (?P<host>\\S+) \"(?P<target>[^\"]*)\" \\[Client (?P<ip>[^\\]]+)\\] \\[Length (?P<bytes>[0-9]+)\\] \\[Gzip [^\\]]*\\](?: \\[Sent-to [^\\]]*\\])? \"(?P<ua>[^\"]*)\" \"(?P<referer>[^\"]*)\"$",
  "nginxErrTime": "^(?:\\S+ )?(\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2}) \\[[a-z]+\\]",
  "apacheErrTime": "^\\[([A-Za-z]{3} [A-Za-z]{3} +\\d{1,2} \\d{2}:\\d{2}:\\d{2}(?:\\.[0-9]+)? \\d{4})\\]",
  "errorClient": "(?:, client: ([^, ]+)|\\[client (\\[[^\\]]+\\](?::[0-9]+)?|[^ ]+)\\])",
  "errorReq": "request: \"((?:[^\"\\\\]|\\\\.)*)\"",
  "invalidURI": "Invalid URI in request (.*?)(?: +|$)$",
  "apacheAuth": "\\[auth_basic:[^\\]]+\\].*authentication failure for \"([^\"]+)\": Password Mismatch",
  "apacheNotFound": "\\[auth_basic:[^\\]]+\\].*user [^:]+ not found: \"?([^\" ]+)\"?",
  "apacheDenied": "\\[authz_core:[^\\]]+\\].*client denied by server configuration: (.*)$",
  "nginxAuthFailure": "user \"[^\"]+\"(?: was not found in \"[^\"]+\"|: password mismatch)",
  "errorHost": "server: ([^,]*),"
}
