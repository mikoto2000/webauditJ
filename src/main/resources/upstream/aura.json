{
  "signatures": [
    {
      "id": "sqli",
      "severity": "high",
      "pattern": "(union[ +/*]*select|union[ +](all|distinct)[ +]select|information_schema|table_schema|column_name|group_concat|load_file[ (]|into[ +]outfile|into[ +]dumpfile|sleep[ (][ 0-9]|benchmark[ (]|pg_sleep[ (]|waitfor[ +]delay|extractvalue[ (]|updatexml[ (]|' or '|\\\" or \\\"|%27[ +]?or|%22[ +]?or|or[ +]1[ ]?=[ ]?1|and[ +]1[ ]?=[ ]?1|' and '|'--|'\\#|;--|/\\*!|xp_cmdshell|sp_executesql|utl_http|dbms_lock|convert[ (]int|cast[ (]|concat[ (]0x|char[ (][0-9]|0x[0-9a-f][0-9a-f][0-9a-f]|having[ +]1[ ]?=|%27%20or|%20or%201=1)",
      "description": "SQL injection payloads or probes"
    },
    {
      "id": "nosqli",
      "severity": "high",
      "pattern": "(\\[\\$ne\\]|\\[\\$gt\\]|\\[\\$lt\\]|\\[\\$gte\\]|\\[\\$lte\\]|\\[\\$regex\\]|\\[\\$where\\]|\\[\\$exists\\]|\\[\\$in\\]|\\[\\$nin\\]|\\[\\$or\\]|\\$where[ ]?[=:]|%5b%24ne%5d|%24where|\\{\\$gt|\\{\\$ne|\\{\\$where|mapreduce\\{)",
      "description": "NoSQL / MongoDB operator injection"
    },
    {
      "id": "command_injection",
      "severity": "critical",
      "pattern": "(;[ +]?(id|whoami|uname|cat|ls|dir|ping|curl|wget|nc|bash|sh|powershell|cmd)[ +;/]|\\|[ +]?(id|whoami|uname|cat|ls|nc|bash|sh|curl|wget)|\\$\\([ ]?(id|whoami|uname|cat|ls)|%24%28|%60|%0a(id|whoami|uname|cat|ls|ping)|/bin/(sh|bash|dash|zsh|busybox)|bash[ +]-i|nc[ +]-e|/dev/tcp/|chmod[ +]+[0-9x]|%3b(id|whoami|uname)|%7c(id|whoami)|\\$\\{ifs\\}|\\$ifs|/etc/cron)",
      "description": "OS command injection"
    },
    {
      "id": "shellshock",
      "severity": "critical",
      "pattern": "(\\(\\)[ +]*\\{|%28%29[ +]*%7b|\\(\\)[ +]*\\{[ +:;]|%28%29%20%7b)",
      "description": "Shellshock / Bash function-definition injection"
    },
    {
      "id": "ssti",
      "severity": "high",
      "pattern": "(\\{\\{[ ]?[0-9*]|\\{\\{[ ]?(config|self|request|session|settings|g\\.)|\\$\\{[ ]?[0-9*]|\\$\\{[ ]?(t|java|runtime|class)|\\#\\{[ ]?[0-9]|\\<%[ ]?=[ ]?[0-9]|%7b%7b[0-9]|freemarker|velocity\\.|\\{\\{7[ ]?\\*[ ]?7|\\$\\{7[ ]?\\*[ ]?7|\\{%[ ]?(if|for|import)|\\{\\{[ ]?['\\\"].*['\\\"]\\.)",
      "description": "Server-side template injection"
