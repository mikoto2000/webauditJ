<#ftl output_format="HTML" auto_esc=true>
<!doctype html>
<html lang="${lang}"><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${t("WebAuditJ investigation report")}</title>
<style>
:root{color-scheme:light;--ink:#182630;--muted:#52626c;--line:#dce4e8;--accent:#126579}*{box-sizing:border-box}body{margin:0;background:#f3f6f7;color:var(--ink);font:15px/1.65 system-ui,sans-serif}main{max-width:1200px;margin:0 auto;padding:40px 24px}h1{font-size:34px;margin:0}h2{margin-top:36px;font-size:23px}h3{font-size:18px}p{overflow-wrap:anywhere}.eyebrow{color:var(--accent);font-weight:700}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:24px 0}.metric,article,section.panel{background:white;border:1px solid var(--line);border-radius:10px;padding:20px}.metric strong{display:block;font-size:29px}article{margin:16px 0}pre{background:#eef3f5;padding:14px;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.55 ui-monospace,monospace}table{border-collapse:collapse;width:100%;font-size:13px}th,td{padding:9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;overflow-wrap:anywhere}th{background:#eef3f5}.table{overflow-x:auto}.tag{display:inline-block;border:1px solid var(--line);padding:2px 8px;border-radius:20px;margin:2px}.warning{border-left:4px solid #bb8123;padding-left:14px}details{margin:12px 0}summary{cursor:pointer;color:var(--accent);font-weight:600}a{color:var(--accent)}footer{margin-top:40px;color:var(--muted)}
</style></head><body><main>
<div class="eyebrow">${t("OFFLINE HTTP LOG INVESTIGATION")}</div><h1>${t("WebAuditJ report")}</h1>
<p class="muted">${t("Version")} ${version} ${t("· rules")} ${rules_version} · ${analyzed_at}</p>
<p><strong>${t("Analysis")} <#if partial>${t("partial — inspect coverage warnings")}<#else>${t("completed")}</#if></strong>${t(". Access logs cannot confirm compromise. Attack scores and outcome confidence describe different evidence.")}</p>
<div class="grid"><div class="metric">${t("Parsed requests")}<strong>${requests?c}</strong></div><div class="metric">${t("Unparsed lines")}<strong>${unparsed?c}</strong></div><div class="metric">${t("WebAudit incidents")}<strong>${findings?size?c}</strong></div><div class="metric">${t("Input files")}<strong>${files?size?c}</strong></div></div>
<p>${t("Period:")} ${first!t("unknown")} ${t("to")} ${last!t("unknown")}${t(". Duplicate observations excluded:")} ${duplicates?c}.</p>
<h2>${t("Coverage and warnings")}</h2><section class="panel"><#list warnings as warning><p class="warning">${diagnostic(warning)}</p></#list>
<details><summary>${t("Input files and missing fields")}</summary><div class="table"><table><tr><th>${t("File")}</th><th>${t("Parsed")}</th><th>${t("Unparsed")}</th><th>${t("Diagnostic")}</th></tr><#list files as f><tr><td>${f.path}</td><td>${f.parsed?c}</td><td>${f.unparsed?c}</td><td>${diagnostic(f.error!"")}<#if f.duplicate_of??>${t("Duplicate of")} ${f.duplicate_of}</#if></td></tr></#list></table></div><#list missing_fields as name,count><p>${t(name)}: ${count?c} ${t("missing")}</p></#list></details></section>
<h2>${t("WebAudit incidents")}</h2><#if findings?size == 0><p>${t("No WebAudit incidents. Review the independent upstream detections and coverage.")}</p></#if>
<#if findings?has_content><div class="table" id="incident-list"><table><thead><tr><th scope="col">${t("Incident")}</th><th scope="col">${t("Severity / score")}</th><th scope="col">${t("Outcome")}</th><th scope="col">${t("Peer")}</th><th scope="col">${t("Count")}</th></tr></thead><tbody>
<#list findings as f><tr><td><a href="#${f.id}">${f.id}</a> · ${t(f.phase)}</td><td>${t(f.severity)} / ${f.attack_score?c}</td><td>${outcome(f.outcome.verdict)}</td><td>${f.ip}</td><td>${f.count?c}</td></tr></#list>
</tbody></table></div></#if>
<#list findings as f><article id="${f.id}"><span class="tag">${t(f.severity)}</span><span class="tag">${outcome(f.outcome.verdict)}</span><h3>${f.ip} · ${t(f.phase)}</h3><p>${f.id} · ${f.count?c} ${t("observations · score")} ${f.attack_score?c} ${t("· outcome confidence")} ${f.outcome.confidence?c}</p><p>${t("Host")} ${f.host!t("unknown")} ${t("· User-Agent")} ${f.user_agent!t("unknown")}<br>${f.first!t("timezone unknown")} ${t("to")} ${f.last!t("timezone unknown")}</p>
<#if f.geoip??><p>${t("GeoIP:")} ${t(f.geoip.status)} · ${f.geoip.country_code!t("unknown")} ${f.geoip.country_name!""} ${t("· ASN")} ${(f.geoip.asn?c)!t("unknown")} ${f.geoip.asn_organization!""} ${t("· country")} ${t(f.geoip.country_status)}${t(", ASN")} ${t(f.geoip.asn_status)}</p></#if>
<h4>${t("Detection and outcome reasoning")}</h4><ul><#list f.reasons![] as reason><li>${t(reason)}</li></#list><#list f.outcome.reasons as reason><li>${t(reason)}</li></#list></ul><#list f.correlation![] as basis><p class="muted">${t(basis)}</p></#list>
<details open><summary>${t("Evidence and normalization")}</summary><#list f.evidence![] as evidence><p><strong>${evidence.event.file}:${evidence.event.line?c}</strong><#if evidence.event.evidence_truncated!false> ${t("· evidence truncated")}</#if></p><pre>${evidence.event.raw}</pre><p>${t("Time:")} ${evidence.event.time!evidence.event.wall_time!t("unknown")} ${t("· Status")} ${(evidence.event.status?c)!t("unknown")} ${t("· Bytes")} ${(evidence.event.bytes?c)!t("unknown")}</p><#list evidence.normalization.steps![] as step><span class="tag">${t(step)}</span></#list><#list evidence.normalization.variants as variant><pre>${variant}</pre></#list><#list evidence.normalization.warnings![] as warning><p>${diagnostic(warning)}</p></#list></#list></details>
<details><summary>${t("Missing evidence and next investigation steps")}</summary><ul><#list f.outcome.missing as item><li>${t(item)}</li></#list></ul><ol><#list f.outcome.next as item><li>${t(item)}</li></#list></ol></details><section><h4>${t("How to establish the outcome")}</h4><p>${t("Correlate records using this incident's time (verify the timezone), target host and URL, and a request ID when available. The source IP alone does not establish the same user or request.")}</p>
<#list f.outcome.investigation![] as guide><h5>${t("Attack / detection category:")} ${t(guide.category)}</h5><dl><dt>${t("Why the outcome is uncertain")}</dt><dd>${t(guide.why_unknown)}</dd><dt>${t("Where to check")}</dt><dd><ul><#list guide.where_to_check as place><li>${t(place)}</li></#list></ul></dd><dt>${t("Evidence needed to determine the outcome")}</dt><dd><strong>${t("Evidence supporting success:")}</strong> ${t(guide.success_evidence)}</dd><dd><strong>${t("Evidence supporting failure:")}</strong> ${t(guide.failure_evidence)}</dd></dl></#list>
<p class="muted">${t("These are investigation guidelines, not observed evidence. Absence of traces alone does not establish failure. The outcome may remain unknown if historical records are unavailable. Failure evidence applies only to the requests verified, not necessarily the entire incident. Reproduction in the current environment alone cannot establish the historical outcome. WebAudit does not ingest additional evidence to update the verdict automatically.")}</p></section><p><a href="#incident-list">${t("Back to incident list")}</a></p></article></#list>
<#assign upstreamDetections = (upstream_alerts![]) + (aura_matches![]) + (aura_analysis![])>
<h2>${t("Independent Hub and Aura detections")}</h2><section class="panel"><p>${t("Source detections do not establish attack success.")}</p><div class="table" id="upstream-list"><table><thead><tr><th scope="col">${t("Source / rule")}</th><th scope="col">${t("Peer / group")}</th><th scope="col">${t("Count")}</th><th scope="col">${t("Period:")}</th></tr></thead><tbody>
<#list upstreamDetections as a><tr><td>${a.source}<br><a href="#upstream-${a?index?c}">${a.rule_id}</a></td><td>${a.ip}<br>${a.group}</td><td>${a.count?c}</td><td>${a.first!a.wall_first!t("unknown")} ${t("to")} ${a.last!a.wall_last!t("unknown")}</td></tr></#list>
</tbody></table></div></section>
<#list upstreamDetections as a><article id="upstream-${a?index?c}"><h3>${a.source} · ${a.rule_id}</h3><p>${t("Peer / group")}: ${a.ip} / ${a.group}<br>${t("Count")}: ${a.count?c}</p><h4>${t("Period and source references")}</h4><p>${a.first!a.wall_first!t("unknown")} ${t("to")} ${a.last!a.wall_last!t("unknown")}</p><#list a.events![] as ref><p>${ref.file}:${ref.line?c}</p></#list><#if a.evidence_truncated!false><p class="warning">${t("Evidence references truncated")}</p></#if><h4>${t("Evidence samples (up to eight original log references)")}</h4><#if a.source == "AuraDFIR/analysis"><p class="muted">${t("These are samples from the aggregation, not individual requests confirmed as attacks.")}</p></#if><#list a.evidence![] as sample><p><strong>${sample.file}:${sample.line?c}</strong></p><pre>${sample.raw}</pre><#if sample.evidence_truncated!false><p class="warning">${t("Evidence fields are truncated for bounded retention. Read the original file at the referenced line for complete data.")}</p></#if><#else><p>${t("No retained source-log samples. Check the original input logs.")}</p></#list><#if a.metadata??><dl><#list a.metadata as key,value><dt>${key}</dt><dd>${value}</dd></#list></dl></#if><p><a href="#upstream-list">${t("Back to Hub and Aura detection list")}</a></p></article></#list>
<#if geoip??><h2>${t("GeoIP and ASN investigation context")}</h2><section class="panel"><p>${t(geoip.context)}</p><#if geoip.truncated><p class="warning">${t("Peer limit reached. Counts are lower bounds.")}</p></#if><#if geoip.correlations_truncated><p class="warning">${t("Correlation candidates truncated.")}</p></#if>
<h3>${t("Database provenance")}</h3><#list geoip.databases as d><p><strong>${t(d.role)} — ${d.provider}</strong><br>${d.file}<br>${d.type} ${t("· published")} ${d.version!t("unknown")} ${t("· built")} ${d.build_time!t("unknown")} ${t("· retrieved")} ${d.downloaded_at!t("unknown")}<br>${t("Source")} ${d.source_url!t("unknown")} ${t("· generation")} ${d.generation!t("unknown")} ${t("· last checked")} ${d.last_checked_at!t("unknown")}<br>${d.license}</p></#list>
<#list ["countries","asns"] as set><h3>${t(set?cap_first)}</h3><div class="table"><table><tr><th>${t("Group")}</th><th>${t("Requests")}</th><th>${t("IPs / suspicious IPs")}</th><th>${t("Incidents / techniques")}</th><th>${t("IP sample")}</th></tr><#list geoip[set] as g><tr><td>${g.key} ${g.name}</td><td>${g.requests?c}</td><td>${g.ip_count?c} / ${g.suspicious_ip_count?c}</td><td>${g.incidents?c} · <#list g.categories![] as category>${t(category)}<#sep>, </#list></td><td>${(g.ips![])?join(", ")}</td></tr></#list></table></div></#list>
<h3>${t("Similar activity within known ASNs")}</h3><#list geoip.correlations as c><p><strong>${t("ASN")} ${c.asn} · ${t(c.category)}</strong><br>${c.path} ${t("· host")} ${c.target_host!t("unknown")}<br>${c.window_start} ${t("to")} ${c.window_end} · ${c.ip_count?c} ${t("IPs")}<br>${c.ips?join(", ")}<br>${t(c.basis)}</p></#list>
<details><summary>${t("All retained peers")}</summary><div class="table"><table><tr><th>${t("IP")}</th><th>${t("Requests")}</th><th>${t("Classification / state")}</th><th>${t("Country")}</th><th>${t("ASN")}</th></tr><#list geoip.peers![] as p><tr><td>${p.ip}</td><td>${p.requests?c}</td><td>${t(p.info.classification)} / ${t(p.info.status)}</td><td>${p.info.country_code!t("unknown")} ${p.info.country_name!""} / ${t(p.info.country_status)}</td><td>${(p.info.asn?c)!t("unknown")} ${p.info.asn_organization!""} / ${t(p.info.asn_status)}</td></tr></#list></table></div></details><p><a href="https://db-ip.com">${t("IP Geolocation by DB-IP")}</a> · <a href="https://creativecommons.org/licenses/by/4.0/">${t("CC BY 4.0")}</a>${t(". Database information is investigation context.")}</p></section></#if>
<h2>${t("Complete report and rule provenance")}</h2><details><summary>${t("Full structured report including supported and unsupported source rules")}</summary><pre>${json_report}</pre></details>
<footer>${t("WebAuditJ · MIT License · Independent implementation referencing AuraDFIR, CrowdSec and CrowdSec Hub. Third-party notices accompany the application. This report uses no external images, scripts or stylesheets.")}</footer>
</main></body></html>
