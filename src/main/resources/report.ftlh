<#ftl output_format="HTML" auto_esc=true>
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WebAuditJ investigation report</title>
<style>
:root{color-scheme:light;--ink:#182630;--muted:#52626c;--line:#dce4e8;--accent:#126579}*{box-sizing:border-box}body{margin:0;background:#f3f6f7;color:var(--ink);font:15px/1.65 system-ui,sans-serif}main{max-width:1200px;margin:0 auto;padding:40px 24px}h1{font-size:34px;margin:0}h2{margin-top:36px;font-size:23px}h3{font-size:18px}p{overflow-wrap:anywhere}.eyebrow{color:var(--accent);font-weight:700}.muted{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin:24px 0}.metric,article,section.panel{background:white;border:1px solid var(--line);border-radius:10px;padding:20px}.metric strong{display:block;font-size:29px}article{margin:16px 0}pre{background:#eef3f5;padding:14px;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.55 ui-monospace,monospace}table{border-collapse:collapse;width:100%;font-size:13px}th,td{padding:9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top;overflow-wrap:anywhere}th{background:#eef3f5}.table{overflow-x:auto}.tag{display:inline-block;border:1px solid var(--line);padding:2px 8px;border-radius:20px;margin:2px}.warning{border-left:4px solid #bb8123;padding-left:14px}details{margin:12px 0}summary{cursor:pointer;color:var(--accent);font-weight:600}a{color:var(--accent)}footer{margin-top:40px;color:var(--muted)}
</style></head><body><main>
<div class="eyebrow">OFFLINE HTTP LOG INVESTIGATION</div><h1>WebAuditJ report</h1>
<p class="muted">Version ${version} · rules ${rules_version} · ${analyzed_at}</p>
<p><strong>Analysis <#if partial>partial — inspect coverage warnings<#else>completed</#if></strong>. Access logs cannot confirm compromise. Attack scores and outcome confidence describe different evidence.</p>
<div class="grid"><div class="metric">Parsed requests<strong>${requests?c}</strong></div><div class="metric">Unparsed lines<strong>${unparsed?c}</strong></div><div class="metric">WebAudit incidents<strong>${findings?size?c}</strong></div><div class="metric">Input files<strong>${files?size?c}</strong></div></div>
<p>Period: ${first!"unknown"} to ${last!"unknown"}. Duplicate observations excluded: ${duplicates?c}.</p>
<h2>Coverage and warnings</h2><section class="panel"><#list warnings as warning><p class="warning">${warning}</p></#list>
<details><summary>Input files and missing fields</summary><div class="table"><table><tr><th>File</th><th>Parsed</th><th>Unparsed</th><th>Diagnostic</th></tr><#list files as f><tr><td>${f.path}</td><td>${f.parsed?c}</td><td>${f.unparsed?c}</td><td>${f.error!""}<#if f.duplicate_of??>Duplicate of ${f.duplicate_of}</#if></td></tr></#list></table></div><#list missing_fields as name,count><p>${name}: ${count?c} missing</p></#list></details></section>
<h2>WebAudit incidents</h2><#if findings?size == 0><p>No WebAudit incidents. Review the independent upstream detections and coverage.</p></#if>
<#list findings as f><article><span class="tag">${f.severity}</span><span class="tag">${f.outcome.verdict}</span><h3>${f.ip} · ${f.phase}</h3><p>${f.id} · ${f.count?c} observations · score ${f.attack_score?c} · outcome confidence ${f.outcome.confidence?c}</p><p>Host ${f.host!"unknown"} · User-Agent ${f.user_agent!"unknown"}<br>${f.first!"timezone unknown"} to ${f.last!"timezone unknown"}</p>
<#if f.geoip??><p>GeoIP: ${f.geoip.status} · ${f.geoip.country_code!"unknown"} ${f.geoip.country_name!""} · ASN ${(f.geoip.asn?c)!"unknown"} ${f.geoip.asn_organization!""} · country ${f.geoip.country_status}, ASN ${f.geoip.asn_status}</p></#if>
<h4>Detection and outcome reasoning</h4><ul><#list f.reasons![] as reason><li>${reason}</li></#list><#list f.outcome.reasons as reason><li>${reason}</li></#list></ul><#list f.correlation![] as basis><p class="muted">${basis}</p></#list>
<details open><summary>Evidence and normalization</summary><#list f.evidence![] as evidence><p><strong>${evidence.event.file}:${evidence.event.line?c}</strong><#if evidence.event.evidence_truncated!false> · evidence truncated</#if></p><pre>${evidence.event.raw}</pre><p>Time: ${evidence.event.time!evidence.event.wall_time!"unknown"} · Status ${(evidence.event.status?c)!"unknown"} · Bytes ${(evidence.event.bytes?c)!"unknown"}</p><#list evidence.normalization.steps![] as step><span class="tag">${step}</span></#list><#list evidence.normalization.variants as variant><pre>${variant}</pre></#list><#list evidence.normalization.warnings![] as warning><p>${warning}</p></#list></#list></details>
<details><summary>Missing evidence and next investigation steps</summary><ul><#list f.outcome.missing as item><li>${item}</li></#list></ul><ol><#list f.outcome.next as item><li>${item}</li></#list></ol></details></article></#list>
<h2>Independent Hub and Aura detections</h2><section class="panel"><p>Source detections do not establish attack success.</p><div class="table"><table><tr><th>Source / rule</th><th>Peer / group</th><th>Count</th><th>Period and source references</th></tr><#list (upstream_alerts![]) + (aura_matches![]) + (aura_analysis![]) as a><tr><td>${a.source}<br>${a.rule_id}</td><td>${a.ip}<br>${a.group}</td><td>${a.count?c}</td><td>${a.first!a.wall_first!"unknown"} to ${a.last!a.wall_last!"unknown"}<#list a.events![] as ref><br>${ref.file}:${ref.line?c}</#list><#if a.evidence_truncated!false><br>Evidence references truncated</#if><#if a.metadata??><#list a.metadata as key,value><br>${key}: ${value}</#list></#if></td></tr></#list></table></div></section>
<#if geoip??><h2>GeoIP and ASN investigation context</h2><section class="panel"><p>${geoip.context}</p><#if geoip.truncated><p class="warning">Peer limit reached. Counts are lower bounds.</p></#if><#if geoip.correlations_truncated><p class="warning">Correlation candidates truncated.</p></#if>
<h3>Database provenance</h3><#list geoip.databases as d><p><strong>${d.role} — ${d.provider}</strong><br>${d.file}<br>${d.type} · published ${d.version!"unknown"} · built ${d.build_time!"unknown"} · retrieved ${d.downloaded_at!"unknown"}<br>Source ${d.source_url!"unknown"} · generation ${d.generation!"unknown"} · last checked ${d.last_checked_at!"unknown"}<br>${d.license}</p></#list>
<#list ["countries","asns"] as set><h3>${set?cap_first}</h3><div class="table"><table><tr><th>Group</th><th>Requests</th><th>IPs / suspicious IPs</th><th>Incidents / techniques</th><th>IP sample</th></tr><#list geoip[set] as g><tr><td>${g.key} ${g.name}</td><td>${g.requests?c}</td><td>${g.ip_count?c} / ${g.suspicious_ip_count?c}</td><td>${g.incidents?c} · ${(g.categories![])?join(", ")}</td><td>${(g.ips![])?join(", ")}</td></tr></#list></table></div></#list>
<h3>Similar activity within known ASNs</h3><#list geoip.correlations as c><p><strong>ASN ${c.asn} · ${c.category}</strong><br>${c.path} · host ${c.target_host!"unknown"}<br>${c.window_start} to ${c.window_end} · ${c.ip_count?c} IPs<br>${c.ips?join(", ")}<br>${c.basis}</p></#list>
<details><summary>All retained peers</summary><div class="table"><table><tr><th>IP</th><th>Requests</th><th>Classification / state</th><th>Country</th><th>ASN</th></tr><#list geoip.peers![] as p><tr><td>${p.ip}</td><td>${p.requests?c}</td><td>${p.info.classification} / ${p.info.status}</td><td>${p.info.country_code!"unknown"} ${p.info.country_name!""} / ${p.info.country_status}</td><td>${(p.info.asn?c)!"unknown"} ${p.info.asn_organization!""} / ${p.info.asn_status}</td></tr></#list></table></div></details><p><a href="https://db-ip.com">IP Geolocation by DB-IP</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>. Database information is investigation context.</p></section></#if>
<h2>Complete report and rule provenance</h2><details><summary>Full structured report including supported and unsupported source rules</summary><pre>${json_report}</pre></details>
<footer>WebAuditJ · MIT License · Independent implementation referencing AuraDFIR, CrowdSec and CrowdSec Hub. Third-party notices accompany the application. This report uses no external images, scripts or stylesheets.</footer>
</main></body></html>
